# =============================================================================
# VoxVerity Environment Variables
# =============================================================================
# 
# HOW THIS WORKS:
# - This .env.example is the TEMPLATE with descriptions
# - Copy this file to apps/web/.env.local (for the Next.js web app)
# - The AI service (Python/FastAPI) reads from this same .env.local
# - NEVER commit .env.local to git (it's in .gitignore)
#
# FILE LOCATIONS:
#   .env.example              <- This template (committed to git)
#   apps/web/.env.local       <- Actual secrets (NOT committed)
#   .env.local                <- Root copy (optional, same as above)
#
# =============================================================================

# ─── Web Application ────────────────────────────────────────────────────────

# Base URL for the Next.js app (used for redirects, OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# AUTHENTICATION (Auth.js / NextAuth v5)
# =============================================================================
# 
# AUTH_SECRET: Required for session encryption. Generate with:
#   npx auth secret
#   Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# OAuth Provider Credentials:
#   1. Go to https://console.cloud.google.com (Google)
#   2. Go to https://github.com/settings/developers (GitHub)
#   3. Create OAuth app, set callback URL to: http://localhost:3000/api/auth/callback/[provider]
#   4. Paste Client ID and Secret below
#
AUTH_SECRET=your-auth-secret-generate-with-npx-auth-secret

# NEXTAUTH_URL: Base URL used for session cookies and OAuth callbacks.
# Keep this at the URL you actually access the app from (e.g.
# http://localhost:3000) — it must match the callback URL registered in
# the Google/GitHub OAuth console: <NEXTAUTH_URL>/api/auth/callback/<provider>
NEXTAUTH_URL=http://localhost:3000

# GOOGLE_REDIRECT_URI: Optional. Full Google OAuth redirect (callback) URI.
# When set, auth.ts passes it to the Google provider as redirectProxyUrl so
# the exact URI sent to Google matches what is registered in the console.
# When unset, NextAuth derives it from NEXTAUTH_URL (no hardcoding in code).
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Google OAuth (optional - for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional - for GitHub sign-in)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# DATABASE (Supabase - PostgreSQL)
# =============================================================================
#
# Supabase is used ONLY as the database. Auth is handled by Auth.js.
#
# Setup:
#   1. Create project at https://supabase.com
#   2. Go to Settings -> API
#   3. Copy Project URL, anon key, and service_role key
#   4. Run SQL migrations in Supabase SQL Editor:
#      - supabase/migrations/001_initial_auth_and_profiles.sql
#      - supabase/migrations/002_full_schema.sql
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your-service-role-key

# =============================================================================
# AI SERVICE (Python/FastAPI)
# =============================================================================
#
# The AI service runs separately on port 8000.
# Start it with:
#   cd services/ai-service
#   .venv/Scripts/activate   (Windows)
#   source .venv/bin/activate (Linux/Mac)
#   uvicorn app.main:app --reload --port 8000
#
# AI_SERVICE_URL: Where the web app connects to the AI service
# AI_SERVICE_API_KEY: Optional API key for securing the AI service
#
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# Shared HMAC secret for short-lived WebSocket auth tokens.
# Must be the same in both Next.js (.env.local) and AI service (.env).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WS_TOKEN_SECRET=your-ws-token-secret-here

# CORS origins allowed by the AI service (comma-separated)
# For production, replace with your actual deployed domain(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.5:3000

# =============================================================================
# BLOCKCHAIN (Polygon Amoy Testnet)
# =============================================================================
#
# Blockchain is OPTIONAL for the prototype.
# Used to register evidence hashes on-chain for tamper-evident provenance.
#
# Setup:
#   1. Get test MATIC from https://www.alchemy.com/faucets/polygon-amoy
#   2. Create a wallet and export private key
#   3. Deploy the VoiceIntegrityRegistry contract:
#      cd blockchain
#      npm install
#      npx hardhat run scripts/deploy.js --network amoy
#   4. Copy the deployed contract address below
#
# NEVER use mainnet or real funds for the prototype!
#
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_PRIVATE_KEY=
VOICE_REGISTRY_ADDRESS=
CHAIN_ID=80002

# =============================================================================
# NOTES
# =============================================================================
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-side only.
#
# Supabase service role key and blockchain private key are SENSITIVE.
# Never expose them to the client or commit them to git.
#
# For production deployment:
#   - Use your hosting platform's environment variable settings
#   - Never put secrets in code or .env files in production
#   - Use secrets management (e.g., Vercel Environment Variables)
